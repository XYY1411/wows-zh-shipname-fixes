"\n"
"Arashio: Quite adorable.\n"
"\n"
"Michishio: Aww! She's so cute!"

msgid "IDS_PCZC1089_AZURLANE_8_1_2"
msgstr "Not Your Lucky Day"

msgid "IDS_PCZC1089_AZURLANE_8_1_2_DESCRIPTION"
msgstr ""
