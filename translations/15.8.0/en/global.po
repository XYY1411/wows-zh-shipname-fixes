msgid "IDS_OP_E13_1_BOSS_BATTLE_START_2_CHAT"
msgstr ""
"We are Borg. Existence as you know it is over. We will add your biological "
"and technological distinctiveness to our own. Resistance is Futile."

msgid "IDS_OP_E13_1_BOSS_BATTLE_START_3"
msgstr " "

msgid "IDS_OP_E13_1_BOSS_BATTLE_START_3_CHAT"
