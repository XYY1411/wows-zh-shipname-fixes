msgid "IDS_000_001_BEWARE_RASPUTIN_WARNING"
msgstr ""
"Destroy Rasputin!\n"
"Don't let it lay waste to Transylvania!"

msgid "IDS_000_001_MAIN_TASK_BRIEFING"
msgstr ""
"Escort Transylvania to the Portal,\n"
"protecting her from any harm!"

msgid "IDS_000_001_MAIN_TASK_TASK_END_F"
msgstr ""
"Operation failed.\n"
"Transylvania was destroyed."

msgid "IDS_000_001_MAIN_TASK_TASK_END_S"
