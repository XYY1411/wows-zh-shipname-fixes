msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY601_MASSHEAL_AFD2024"
msgstr ""
"Regenerates ship's HP.\n"
"\n"
"Extinguishes fires, removes instances of flooding, and repairs damaged modules. Prevents enemy submarine-launched torpedoes from homing.\n"
"\n"
"Effect applies to all allied ships on your team."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY602_SMOKESCREEN_AFD2024"
msgstr ""
"Summons an air group with Smoke Curtain Generator to a designated area. The air group generates a smokescreen that reduces the risk of allied ships being detected by the enemy.\n"
"\n"
"These aircraft cannot spot hostile ships."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY603_SABOTAGE_AFD2024"
msgstr ""
"The opposing team stops receiving points and the allied team stops losing "
"them."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY604_RECONNAISSANCESQUAD_AFD2024"
msgstr ""
"Summons bombers to a designated area. They automatically drop HE bombs on "
"enemy ships."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY605_MINEFIELD_AFD2024"
msgstr ""
"Summons mine-laying aircraft to a designated area.\n"
"\n"
"Mines inflict substantial damage and may trigger flooding upon contact with enemy ships.\n"
"\n"
"These aircraft cannot spot hostile ships."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY606_MANEUVERABILITYBOOST_AFD2024"
msgstr ""
"Increases the ship's maximum speed and engine power; reduces the turning circle radius.\n"
"\n"
"Effect applies to all allied ships on your team."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY607_INVULNERABILITY_AFD2024"
msgstr ""
"Provides damage resistance.\n"
"\n"
"Effect applies to all allied ships on your team."

msgid "IDS_REWARD_CONSUME_DESCRIPTION_PXY608_FOCUSFIRE_AFD2024"
msgstr "Increases inflicted allied damage on selected target."

