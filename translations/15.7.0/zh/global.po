msgid "IDS_PCEE089_VALOR_DESCRIPTION"
msgstr "继续帮助退伍军人的家庭的奖励。"

msgid "IDS_PCEE090_HAWAII_FLAG"
msgstr "夏威夷"

msgid "IDS_PCEE090_HAWAII_FLAG_DESCRIPTION"
msgstr ""
"夏威夷群岛位于大洋地区。在第二次大战期间，这片群岛作为M系海军大洋舰队的前线基地，扮演了重要角色。1941年12月7日，R系海军对M系海军基地发动突然袭击，将M系拖入战争。阿拉斯加级大型巡洋舰CB-3本应成为第一艘以夏威夷命名的M系海军舰艇，但它未能建成。"

msgid "IDS_PCEE090_MILITARY_MONTH_CONTRIBUTOR_FLAG_V2"
msgstr "军人感恩月"

msgid "IDS_PCEE090_MILITARY_MONTH_CONTRIBUTOR_FLAG_V2_DESCRIPTION"
msgstr "慈善捐款"

msgid "IDS_PCEE091_VICTORY_DAY_EU"
msgstr "胜利日"

msgid "IDS_PCEE091_VICTORY_DAY_EU_DESCRIPTION"
msgstr "庆祝胜利日。"

