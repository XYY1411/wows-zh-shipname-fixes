msgstr "指派至远征的战舰："

msgid "IDS_NAVAL_BASE_TASK_STATUS_ASSIGNED_SHIPS"
msgstr "已组建远征舰队"

msgid "IDS_NAVAL_BASE_TASK_STATUS_IN_PROGRESS"
