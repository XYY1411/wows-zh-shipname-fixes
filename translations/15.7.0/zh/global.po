msgid "IDS_PCEE031_BLUE_STEEL_EXTRA_DESCRIPTION"
msgstr "参考自“ARPEGGIO OF BLUE STEEL -ARS NOVA-”。"

msgid "IDS_PCEE032_ARIZONA_MEMORIAL"
msgstr "亚利桑那"

msgid "IDS_PCEE032_ARIZONA_MEMORIAL_DESCRIPTION"
msgstr ""
"珍珠港事件期间，亚利桑那遭受到轰炸。它随后爆炸并且沉没，造成 1,177 名军官及船员丧生。\n"
"残骸至今仍平静地躺在珍珠港下方的Y系海军亚利桑那号战舰纪念馆底下。"

msgid "IDS_PCEE033_KRASNYI_KRIM_FLAG"
msgstr "红色克里米亚"

msgid "IDS_PCEE033_KRASNYI_KRIM_FLAG_DESCRIPTION"
msgstr ""
"S系海上保卫军成立于1942年的大战期间。\n"
"战舰船员被授予卫军地位，以表彰他们在保卫祖国、抵御D系侵略者方面的突出表现。表彰的内容是船员坚定的决心、勇气、纪律、井井有条的行为以及英雄气概。"

msgid "IDS_PCEE034_SCHARNHORST"
msgstr "沙恩霍斯特"

msgid "IDS_PCEE034_SCHARNHORST_DESCRIPTION"
msgstr "该战舰得名于格哈德·冯·沙恩霍斯特将军，1813年D系战争的民族英雄。"

msgid "IDS_PCEE035_DUNKERQUE"
msgstr "敦刻尔克"

msgid "IDS_PCEE035_DUNKERQUE_DESCRIPTION"
msgstr ""
"敦刻尔克是为反击德意志级袖珍战列舰而设计。\n"
"当它们服役时，只有Y系海军及R系海军仅存的最后一批战列巡洋舰能与之相比。"

msgid "IDS_PCEE036_TAIWAN_NAVY"
msgstr "C国海军"

msgid "IDS_PCEE036_TAIWAN_NAVY_DESCRIPTION"
msgstr ""
"现代C系海军的前身是1911年推翻王朝后成立的C系临时政府海军部，配备有117艘战舰和38000名人员。其行动包括在海峡及周边水域的海上巡逻，以及战时的反打击和反入侵行动。"

msgid "IDS_PCEE037_VETERANS_FLAG"
msgstr "老兵"

msgid "IDS_PCEE037_VETERANS_FLAG_DESCRIPTION"
msgstr "颁发给参加推荐计划的玩家。此旗帜颁给邀请一位好友加入游戏并用VI级舰艇进行一场战斗的玩家。"

msgid "IDS_PCEE038_OLYMPICS_FLAG"
