msgstr "正在接受任务"

msgid "IDS_NAVAL_BASE_SSE_STATE_OVERCHARGE_REQUIRED"
msgstr "强化%(area)s区域后才能接受此作战任务"

msgid "IDS_NAVAL_BASE_START_EXPEDITION_FAILED"
msgstr "未能开始远征。"

msgid "IDS_NAVAL_BASE_STATUS_COMPLETED_MENU_EXPEDITIONS"
msgstr "已开始全部远征。"

msgid "IDS_NAVAL_BASE_STATUS_COMPLETED_MENU_MISSIONS"
msgstr "已接受全部作战任务。"

msgid "IDS_NAVAL_BASE_STATUS_COMPLETED_MENU_OVERCHARGE"
msgstr "已应用全部强化次数。"

msgid "IDS_NAVAL_BASE_STATUS_FULLY_COMPLETED_MENU_MISSIONS"
msgstr "已完成全部作战任务。"

msgid "IDS_NAVAL_BASE_STATUS_NO_REWARDS_MENU"
msgstr "目前没有奖励。"

msgid "IDS_NAVAL_BASE_STATUS_PASSIVE_PHASE_MENU"
msgstr "活动即将结束，但您仍可完成区域建造。"

msgid "IDS_NAVAL_BASE_STATUS_PASSIVE_PHASE_MENU_PHOTO_ALBUM"
msgstr "将所有区域提升至最大等级以获取全部奖励，包括VIII级巡洋舰布里奇波特。"

msgid "IDS_NAVAL_BASE_TASK_SETUP_BTN_CLOSE"
msgstr "关闭"

msgid "IDS_NAVAL_BASE_TASK_SETUP_BTN_OVERCHARGE"
msgstr "强化"

msgid "IDS_NAVAL_BASE_TASK_SETUP_BTN_UPGRADE"
msgstr "升级"

msgid "IDS_NAVAL_BASE_TASK_SETUP_HINT_BTN_OVERCHARGE"
msgstr "强化区域"

