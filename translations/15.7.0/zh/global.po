msgid "IDS_PJSD017_YEAR"
msgstr "1922"

msgid "IDS_PJSD024"
msgstr "菖"

msgid "IDS_PJSD024_DESCR"
msgstr ""
"R系最后一级“小型”驱逐舰是在1921年至1923年间建造的8艘菖级驱逐舰。它们实际上是扩大版的枞级。该级驱逐舰的领舰于1921年12月下水。她参加了战争，在沿海巡逻。二次大战期间，她担任护卫舰。1944年3月30日，在空袭期间，该舰被击沉。"

msgid "IDS_PJSD024_FULL"
