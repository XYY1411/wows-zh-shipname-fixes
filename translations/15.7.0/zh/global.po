msgid "IDS_PCEE086_VICTORY_DAY_DESCRIPTION"
msgstr "庆祝胜利日。"

msgid "IDS_PCEE087_DUCA_DAOSTA"
msgstr "奥斯塔公爵"

msgid "IDS_PCEE087_DUCA_DAOSTA_DESCRIPTION"
msgstr "祖国的荣耀 I系海军的水手随时都准备好保卫他们赫赫有名的国家！"

msgid "IDS_PCEE088_NA_EU_COMMUNITY"
