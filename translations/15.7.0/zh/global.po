msgstr[0] "%(amount)s次升级"
msgstr[1] "%(amount)s次升级"
msgstr[2] "%(amount)s次升级"

msgid "IDS_NAVAL_BASE_UPGRADES_PRICE"
msgstr "花费%(price)s升级？"

msgid "IDS_NAVAL_BASE_UPGRADE_FAILED"
msgstr "未能升级区域。"

msgid "IDS_NAVAL_BASE_UPGRADE_GOLD"
msgstr "花费金币升级"

msgid "IDS_NAVAL_BASE_UPGRADE_LEVEL_ACTION"
msgstr "升级区域"

msgid "IDS_NAVAL_BASE_UPGRADE_LEVEL_CURRENT"
msgstr "当前等级："

msgid "IDS_NAVAL_BASE_UPGRADE_LEVEL_NEXT"
msgstr "下一级： %(level)s"

msgid "IDS_NAVAL_BASE_UPGRADE_RESOURCE"
msgstr "花费海军基地补给升级"

msgid "IDS_NAVAL_BASE_UPGRADE_SUCCESS"
msgstr "区域已升级"

msgid "IDS_NAVAL_BASE_UPGRADE_TITLE"
msgstr "升级"

msgid "IDS_NAVAL_BASE_WELCOME_MODAL_TEXT_1"
msgstr ""
"没什么比荣归故里更令人心潮澎湃的了。这幢海滨小屋，是您父亲的旧宅。这里不仅承载着您童年的回忆，也回响着他讲述的那些作为M系海军基地指挥官的传奇往事。当然，还有您儿时心爱的玩具。"

msgid "IDS_NAVAL_BASE_WELCOME_MODAL_TEXT_2"
msgstr ""
"在这些旧物中，您发现了一套覆满灰尘的塑料拼装模型：“M系海港”海军基地。啊，这曾是您的最爱！曾几何时，您在拼装这些港口设施时，总幻想着自己能像父亲一样，成为一名真正的海军军官。如今，您已身披戎装，梦想成真。"

msgid "IDS_NAVAL_BASE_WELCOME_MODAL_TEXT_3"
msgstr ""
"往昔的记忆涌上心头，您决定要重建这座基地。在拼装过程中，再度回味父亲讲述的故事，这位满怀热情的历史爱好者，曾向您倾诉过他军旅生涯的亲身经历，以及他对M系海军历史的深刻记忆。"

msgid "IDS_NAVAL_BASE_WELCOME_MODAL_TEXT_4"
msgstr "逐步完成“M系海港”海军基地的建设。使用在作战任务和远征中获得的海军基地补给来建造和升级区域。在建造过程中，重温儿时回忆。"

msgid "IDS_NAVAL_FLAG"
msgstr "海军旗帜"

msgid "IDS_NAVAL_FLAGS"
msgstr "海军旗帜"

msgid "IDS_NAVAL_FLAG_ARGENTINA"
msgstr "AGT海军"

msgid "IDS_NAVAL_FLAG_ARGENTINA_DESCRIPTION"
msgstr "AG海军军徽的设计和国旗的设计是一致的。这个设计在1861年被采用。"

msgid "IDS_NAVAL_FLAG_AUSTRALIA"
msgstr "A系海军"

msgid "IDS_NAVAL_FLAG_AUSTRALIA_DESCRIPTION"
msgstr "从1911年到1967年之间，皇家澳洲海军所使用的旗帜都和Y系海军所使用的旗帜一样"

msgid "IDS_NAVAL_FLAG_AUSTRIA_HUNGARY"
msgstr "双元帝国"

msgid "IDS_NAVAL_FLAG_AUSTRIA_HUNGARY_DESCRIPTION"
msgstr "双元帝国和皇家战争海军的旗帜。设计于1786年获得A国海军（1867年，双元帝国）的批准，这个图案可以追溯到奥地利大公国时期的古代纹章。"

msgid "IDS_NAVAL_FLAG_BRAZIL"
msgstr "BX海军"

msgid "IDS_NAVAL_FLAG_BRAZIL_DESCRIPTION"
msgstr ""
"BX海军军旗和国旗的外观设计是在1889年BX国成立时批准的，此后只在细节上有所改变。它的中央部分是“秩序与进步”标语和里约热内卢星空的一部分。"

msgid "IDS_NAVAL_FLAG_CANADA"
msgstr "CCA海军"

msgid "IDS_NAVAL_FLAG_CANADA_DESCRIPTION"
msgstr "加拿大Y系海军旗帜，从1911年到1965年，这张旗帜与大不列颠Y系海军的旗帜一样"

msgid "IDS_NAVAL_FLAG_CHILE"
msgstr "CL海军"

msgid "IDS_NAVAL_FLAG_CHILE_DESCRIPTION"
msgstr ""
"CL国旗和海军旗的设计——la Estrella Solitaria（西班牙语中的“孤星”）在1817年完成，经过稍加改动后一直使用到了今日。"

msgid "IDS_NAVAL_FLAG_CHINA"
msgstr "C国海军"

msgid "IDS_NAVAL_FLAG_CHINA_DESCRIPTION"
msgstr "ˊ直到1992年，C系陆军的旗帜把海军也整合了起来，同时用来当作C系的海军旗帜"

msgid "IDS_NAVAL_FLAG_COLOMBIA"
msgstr "GL海军"

msgid "IDS_NAVAL_FLAG_COLOMBIA_DESCRIPTION"
msgstr "GL海军军旗底色是带有特定比例的国家色彩条纹，其中心是GL国徽图案。"

msgid "IDS_NAVAL_FLAG_COMMONWEALTH"
msgstr "CW国家"

msgid "IDS_NAVAL_FLAG_COMMONWEALTH_DESCRIPTION"
msgstr "大英国协的旗帜于1976年设立，这是一面蓝色为底并镶有黄金地球，旁边围绕着C字形的金矛图样"

msgid "IDS_NAVAL_FLAG_EUROPE"
msgstr "E系"

msgid "IDS_NAVAL_FLAG_EUROPE_DESCRIPTION"
msgstr "E系国家的语言和文化差异很大，历史悠久而丰富。但尽管如此，旧世界人民还是成功地实现了统一。"

msgid "IDS_NAVAL_FLAG_GREECE"
msgstr "XL海军"

msgid "IDS_NAVAL_FLAG_GREECE_DESCRIPTION"
msgstr ""
"XL海军军旗的设计在1822年XL建国期间得到批准，并一直沿用至今，只是稍有改动。旗帜的白色和蓝色代表XL的天空和大海；条纹的数量与ελευθερία（在希腊语中意为“自由”）一词中的字母数量相吻合。"

msgid "IDS_NAVAL_FLAG_INDIAN"
msgstr "ID系海军"

msgid "IDS_NAVAL_FLAG_INDIAN_DESCRIPTION"
msgstr ""
"从上世纪20年代开始，该系海军的舰船装饰着Y系海军旗帜。\n"
"当成立时，杰克联盟的旗帜被三色国旗所取代。"

msgid "IDS_NAVAL_FLAG_INDONESIA"
msgstr "IN海军"

msgid "IDS_NAVAL_FLAG_INDONESIA_DESCRIPTION"
msgstr "从1945年开始，该国就使用这面旗帜来当作国旗，一面包含两道红白水平条纹的旗帜当作国家海军旗帜"

msgid "IDS_NAVAL_FLAG_KOREA"
msgstr "HG海军"

msgid "IDS_NAVAL_FLAG_KOREA_DESCRIPTION"
msgstr "从1948年以来，大韩民国就是使用着崇高的终极旗帜太极国旗，来当作海军旗帜"

msgid "IDS_NAVAL_FLAG_MALAYSIA"
msgstr "ML系"

msgid "IDS_NAVAL_FLAG_MALAYSIA_DESCRIPTION"
msgstr "1963年，MLY海军更名为ML系海军，还拥有了新的海军军旗。"

msgid "IDS_NAVAL_FLAG_MEXICO"
msgstr "MEX海军"

msgid "IDS_NAVAL_FLAG_MEXICO_DESCRIPTION"
msgstr "MEX海军军旗在设计上与其国旗一致，由三色组成，中间是国徽。"

msgid "IDS_NAVAL_FLAG_NETHERLANDS"
msgstr "HL国"

msgid "IDS_NAVAL_FLAG_NETHERLANDS_DESCRIPTION"
msgstr "自17世纪以来，H国的国旗和海军旗就一直使用这种由红白蓝组成的横向三色旗。H国国旗是连续使用时间最长最古老的三色旗之一。"

msgid "IDS_NAVAL_FLAG_NEW_ZEALAND"
msgstr "NZ系海军"

msgid "IDS_NAVAL_FLAG_NEW_ZEALAND_DESCRIPTION"
msgstr "自NZ系海军成立，一直到1968年为止，NZ系海军旗帜与Y系海军旗帜都完全一致，白底，绘有Y系旗帜和圣乔治十字。"

msgid "IDS_NAVAL_FLAG_NORWAY"
msgstr "N系海军"

msgid "IDS_NAVAL_FLAG_NORWAY_DESCRIPTION"
msgstr ""
"N系海军军旗为暗红色背景，上有一个蓝白相间的图案。此军旗与N系旗帜的区别仅在于其带有三条尾巴的特殊形状。该旗帜的设计于1905年获得正式批准，并一直沿用至今，未作任何更改。"

msgid "IDS_NAVAL_FLAG_PANAMERICA"
msgstr "FM"

msgid "IDS_NAVAL_FLAG_PANAMERICA_DESCRIPTION"
msgstr "热带地区国家有着靠近的地理位置和相似的语言特征、文化与历史渊源。"

msgid "IDS_NAVAL_FLAG_PAN_ASIA"
msgstr "C国"

msgid "IDS_NAVAL_FLAG_PAN_ASIA_DESCRIPTION"
msgstr "在该国所在地区的传统文化中，龙是最受尊敬的神话生物之一，一般来说，这象征的是智能并与水元素密切相关"

msgid "IDS_NAVAL_FLAG_PERU"
msgstr "PR海军"

msgid "IDS_NAVAL_FLAG_PERU_DESCRIPTION"
msgstr "PR国旗和海军军旗的设计在1825年独立战争期间得到批准。这个带有国徽的红白相间的旗帜现在仍在使用，只是略有改动。"

msgid "IDS_NAVAL_FLAG_POLAND"
msgstr "B国"

msgid "IDS_NAVAL_FLAG_POLAND_DESCRIPTION"
msgstr "B国海军旗。由两条彩带和B国纹章组成。1927年起被海军采用，沿用至今。"

msgid "IDS_NAVAL_FLAG_ROMANIA"
msgstr "RM系海军"

msgid "IDS_NAVAL_FLAG_ROMANIA_DESCRIPTION"
msgstr "1922年至1947年间，RM系海军采用以国旗三色为基础色的海军旗，中央饰有王国徽章。"

msgid "IDS_NAVAL_FLAG_SIAM"
msgstr "T国海军"

msgid "IDS_NAVAL_FLAG_SIAM_DESCRIPTION"
msgstr "T国的海军旗帜从1917年开始使用，这是一面有着红色圆圈，并画着一头白色的大象背景上在挂着国旗"

msgid "IDS_NAVAL_FLAG_SPAIN_1875"
msgstr "X系王国军舰旗"

msgid "IDS_NAVAL_FLAG_SPAIN_1875_DESCRIPTION"
msgstr "此军舰旗于1785年到1931年间歇性使用。旗帜的配色为一定比例的红色和黄色条纹，这样其他人就能从远处识别西班牙舰船。"

msgid "IDS_NAVAL_FLAG_SPAIN_1931"
msgstr "X系舰旗"

msgid "IDS_NAVAL_FLAG_SPAIN_1931_DESCRIPTION"
msgstr "在1931年至1939年间被X系海军使用。设计者想要用三个比例相等的条纹代表X国的所有地区。其中，深紫色的条纹代表卡斯蒂利亚和莱昂。"

msgid "IDS_NAVAL_FLAG_SPAIN_1939"
msgstr "X系国军舰旗"

msgid "IDS_NAVAL_FLAG_SPAIN_1939_DESCRIPTION"
msgstr ""
"此旗帜的设计于1938年获得批准。旗帜的中心元素是一只雄鹰，雄鹰同样是新国徽的一部分。使徒约翰的鹰是君主费迪南德和伊莎贝尔（15-16世纪）的象征之一，他们开启了X国统一的历史。"

msgid "IDS_NAVAL_FLAG_SPAIN_1945"
msgstr "X系国1945年后的军舰旗"

msgid "IDS_NAVAL_FLAG_SPAIN_1945_DESCRIPTION"
