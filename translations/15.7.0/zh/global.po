msgid "IDS_MODAL_WINDOW_PCVE037_RULES_PARAGRAPH_3_TEXT_2"
msgstr "完成次要目标即可解锁战舰配件和其他奖励。"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_HEADER"
msgstr "牢不可破的防线"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_PARAGRAPH_1_TEXT_1"
msgstr "组队在近距离战斗中与敌人对抗，在巨大压力下取得胜利！"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_PARAGRAPH_1_TEXT_2"
msgstr "所有战舰在被摧毁后都可以重新加入战斗。"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_PARAGRAPH_2_HEADER"
msgstr "返回战斗"

msgid "IDS_MODAL_WINDOW_PCVE038_RULES_PARAGRAPH_2_TEXT_1"
msgstr "双方队伍的战舰在被摧毁几秒后可以重新加入战斗。重新加入战斗的次数没有限制。"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_HEADER"
msgstr "危险之路"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_1_TEXT_1"
msgstr "护送受损指挥舰前往目的地。"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_1_TEXT_2"
msgstr "抵御敌人的攻击，完成主要和次要目标，确保指挥舰安全抵达目的地。"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_2_HEADER"
msgstr "指挥舰"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_2_TEXT_1"
msgstr "指挥舰系统已损坏，火炮也已失效，但指挥舰仍在船员抢修的同时向着目的地前进。如果她能在旅途中幸存下来，将作为强大的盟友参加最后的战斗。"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_3_HEADER"
msgstr "支援消耗品"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_3_TEXT_1"
msgstr "您可以使用支援消耗品，强化整个团队，包括指挥舰。"

msgid "IDS_MODAL_WINDOW_PCVE039_RULES_PARAGRAPH_3_TEXT_2"
msgstr "计划好如何使用——使用次数有限。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_HEADER"
msgstr "北极船团"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_1_TEXT_1"
msgstr "在这个行动中，您和您的团队必须找到并护送盟军运输舰前往会合点。随后，它们将驶向盟军控制的水域。运输舰分散在该区域，需要您的保护。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_1_TEXT_2"
msgstr "小心敌人发起的猛烈攻击，同时还要警惕雷区。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_2_HEADER"
msgstr "护航战"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_2_TEXT_1"
msgstr "请务必紧跟运输舰，确保其持续前进。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_2_TEXT_2"
msgstr "没有您的支援，运输舰将会停滞不前，成为敌人攻击的活靶子。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_3_HEADER"
msgstr "行动目标"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_3_TEXT_1"
msgstr "完成主要目标以取得行动胜利。"

msgid "IDS_MODAL_WINDOW_PCVE040_RULES_PARAGRAPH_3_TEXT_2"
msgstr "完成次要目标即可取得星星，并获得“1939-1945编年史”收藏元素，以及“为明日而战活动”中的其他奖励。您获得的星星越多，奖励也就越多。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_HEADER"
msgstr "午夜运输"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_1_TEXT_1"
msgstr "本次行动将在夜幕掩护下进行。您的任务是找到并消灭为地面部队运送补给的敌方驱逐舰。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_1_TEXT_2"
msgstr "预计能见度会很低，同时会有敌方增援部队和一艘主力舰出现。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_2_HEADER"
msgstr "照明区域"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_2_TEXT_1"
msgstr "小心照明弹和被摧毁舰船留下的火光。进入这些区域会立即增加您的被侦测距离。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_2_TEXT_2"
msgstr "利用黑暗来隐蔽您的行动，利用照明来暴露敌方部队。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_3_HEADER"
msgstr "行动目标"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_3_TEXT_1"
msgstr "完成主要目标以取得行动胜利。"

msgid "IDS_MODAL_WINDOW_PCVE041_RULES_PARAGRAPH_3_TEXT_2"
msgstr "完成次要目标即可取得星星，并获得“1939-1945编年史”收藏元素，以及“为明日而战活动”中的其他奖励。您获得的星星越多，奖励也就越多。"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_HEADER"
msgstr "大洋攻势"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_1_TEXT_1"
msgstr "在此行动中，您和您的队友必须与巡洋舰圣地亚哥协同推进并占领关键岛屿。"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_1_TEXT_2"
msgstr "预计将遭遇多波敌人增援和猛烈的岸防炮攻击。"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_2_HEADER"
msgstr "圣地亚哥"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_2_TEXT_1"
msgstr ""
"巡洋舰圣地亚哥在此行动中扮演着至关重要的角色。在占领岛屿时，请与她协调行动，因为圣地亚哥必须位于占领圈中才能占领岛屿。请为她提供掩护，确保其幸存。"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_3_HEADER"
msgstr "行动目标"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_3_TEXT_1"
msgstr "完成主要目标以取得行动胜利。"

msgid "IDS_MODAL_WINDOW_PCVE042_RULES_PARAGRAPH_3_TEXT_2"
msgstr "完成次要目标即可取得星星，并获得“1939-1945编年史”收藏元素，以及“为明日而战活动”中的其他奖励。您获得的星星越多，奖励也就越多。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_HEADER"
msgstr "大战行动"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_1_TEXT_1"
msgstr "每一场行动都重现了大战期间某一特定阶段的重要战役，涵盖了多处历史上爆发激烈战斗的区域。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_1_TEXT_2"
msgstr "您可以加入北极船团，护送运输舰穿越冰封海域；也可以在南大洋地区参与夜间战斗阻击敌人；或是与著名战舰圣地亚哥并肩作战，夺取战略要地。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_2_HEADER"
msgstr "行动"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_2_TEXT_1"
msgstr ""
"在北极船团行动中，您的任务是护送盟军运输舰安全进入盟军控制的海域。运输舰只有在您靠近时才会前进，否则就会停下来成为敌人的目标。准备迎击敌方舰队，穿越布满水雷的危险海域。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_2_TEXT_2"
msgstr "午夜运输行动在夜间进行。您需要追踪并击沉为敌方运输物资的驱逐舰。请尽量避开地图上的照明区域，一旦进入此类区域，您的被侦测距离将立刻增加。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_2_TEXT_3"
msgstr ""
"在大洋攻势中，您将与著名巡洋舰圣地亚哥并肩作战，夺取敌军控制的关键岛屿。要想成功完成本次行动，您必须全程配合圣地亚哥作战，切勿让其被敌方击沉。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_3_HEADER"
msgstr "行动目标"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_3_TEXT_1"
msgstr "完成主要目标以取得行动胜利。"

msgid "IDS_MODAL_WINDOW_PCVE043_RULES_PARAGRAPH_3_TEXT_2"
msgstr "完成次要目标即可取得星星，并获得“1939-1945编年史”收藏元素，以及“为明日而战活动”中的其他奖励。您获得的星星越多，奖励也就越多。"

msgid "IDS_MODAL_WINDOW_PCVE044_RULES_HEADER"
msgstr "战火重燃：2015"

msgid "IDS_MODAL_WINDOW_PCVE044_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE044_RULES_PARAGRAPH_1_TEXT_1"
