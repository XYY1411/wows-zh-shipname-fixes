msgid "IDS_TITLE_PCM079_SPECIAL_MOD_I_AUDACIOUS"
msgstr "强制起飞和降落设备"

msgid "IDS_TITLE_PCM080_SPECIAL_MOD_I_ARP_YAMATO"
msgstr "ARP主炮组指挥仪系统"

msgid "IDS_TITLE_PCM081_SKIPBOMBER_MOD_I"
msgstr "弹跳轰炸机2号改进型"

