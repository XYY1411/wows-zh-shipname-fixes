msgstr "选择的战舰不允许加入战斗训练"

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_CLAN"
msgstr "选择一艘等级合适的战舰。"

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_EVENT"
msgstr "选择一艘等级合适的战舰"

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_OPERATION"
msgstr "选择一艘等级合适的战舰"

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_TRAINING"
msgstr "选择一艘等级合适的战舰"

msgid "IDS_THIS_SHIP_NATION_IS_NOT_ALLOWED_FOR_CLAN"
msgstr "选择一艘系别合适的战舰"

msgid "IDS_THIS_SHIP_NATION_IS_NOT_ALLOWED_FOR_EVENT"
msgstr "选择一艘系别合适的战舰"

msgid "IDS_THIS_SHIP_NATION_IS_NOT_ALLOWED_FOR_OPERATION"
msgstr "选择一艘系别合适的战舰"

msgid "IDS_THIS_SHIP_NATION_IS_NOT_ALLOWED_FOR_TRAINING"
msgstr "选择一艘系别合适的战舰"

msgid "IDS_THROUGH_HIT_TYPE"
msgstr "炮弹过度击穿！"

msgid "IDS_THURSDAY"
msgstr "周四"

msgid "IDS_THURSDAY_FULL"
msgstr "星期四"

msgid "IDS_TILL_CLAN_BATTLE_SEASON_END"
msgstr "距赛季结束剩余时间："

msgid "IDS_TILL_CREW_DEMOBILIZATION_TOOLTIP"
msgstr "指挥官将在 %(_timeLeft)s 后解雇"

msgid "IDS_TILL_END"
msgstr "距结束还有"

msgid "IDS_TILL_START"
msgstr "距开始还有"

msgid "IDS_TIMEZONE_IS_LOCAL"
msgstr "每天队伍战斗时间："

msgid "IDS_TIME_LEFT_FOR_LOOTEXP"
msgstr "下个补给箱解锁于：%(_timeLeft)s"

msgid "IDS_TIME_TILL_CAPTURE_POINT_ACTIVATION"
msgstr "距关键区域出现剩余时间"

msgid "IDS_TIME_TILL_RESPAWN"
msgstr "重返战场："

msgid "IDS_TIME_TO_LOOT"
msgstr "%(_lootTimeStamp)s经验"

msgid "IDS_TIME_TO_WAIT"
msgstr "等待时间"

msgid "IDS_TIPS_ACOUSTIC_TORPEDOES_HOMING"
msgstr "声导鱼雷：定位"

msgid "IDS_TIPS_ACOUSTIC_TORPEDOES_HOMING_DESCRIPTION"
msgstr ""
"潜艇的所发射的鱼雷正在追踪被标记的方向，调整好你的战舰航速和航向。\n"
"\n"
"它们在击中船舷时最具破坏性。\n"
"\n"
"将你的船头转向来袭的鱼雷以降低被击中的风险。"

msgid "IDS_TIPS_AIRCRAFT_AIR_DEFENSE_ENEMY"
msgstr "敌人防空防御"

msgid "IDS_TIPS_AIRCRAFT_AIR_DEFENSE_ENEMY_DESCRIPTION"
msgstr "通过改变飞行中队的速度和方向躲避曳光弹和防空炮弹的爆炸。"

msgid "IDS_TIPS_AIRCRAFT_CARRIER"
msgstr "航空母舰"

msgid "IDS_TIPS_AIRCRAFT_CARRIER_CONTROL"
msgstr "自动驾驶"

msgid "IDS_TIPS_AIRCRAFT_CARRIER_CONTROL_DESCRIPTION"
msgstr "您在控制一个中队时，可以使用战术地图[CMD_TACTICAL_MAP]来设置战舰的行进路线。"

msgid "IDS_TIPS_AIRCRAFT_CARRIER_DESCRIPTION"
msgstr ""
"航空母舰没有主炮组。它们在战斗中的角色是对敌方部队发动空中袭击以及执行侦察任务。\n"
"\n"
"为了获得最佳效果，请尽量靠近战斗行动区域，同时保持不被敌人发现。\n"
"航空母舰很脆弱，应该随时处于友军的掩护下。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_ATTACK_STATE"
msgstr "攻击状态"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_ATTACK_STATE_DESCRIPTION"
msgstr ""
"水面上的白色瞄准线代表您的中队将发动完全瞄准的袭击的位置。按下鼠标左键让飞机飞过目标上方。当瞄准标线变为绿色时，按下鼠标左键以投放炸弹。请注意，如果您在攻击过程中进行移动，精准度会下降。一旦完成攻击，飞机将返回航空母舰。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_BOMBERS_AP"
msgstr "（穿甲）轰炸机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_BOMBERS_AP_DESCRIPTION"
msgstr "这种类型的飞机装备的穿甲炸弹能有效对抗中型和重型装甲的目标。请从船首和船尾攻击敌方战舰。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_BOMBERS_HE"
msgstr "（高爆）轰炸机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_BOMBERS_HE_DESCRIPTION"
msgstr "这种类型的飞机装备的高爆炸弹能使敌舰起火。请从船首和船尾攻击敌方战舰。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_CONTROL"
msgstr "航空中队控制"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_CONTROL_DESCRIPTION"
msgstr ""
"使用[CMD_THROTTLE_UP] 和 [CMD_THROTTLE_DOWN] 键控制飞机的速度。中队加速和减速都会引起引擎过热。当飞机以巡航速度飞行时，引擎就能冷却。\n"
"\n"
"使用[CMD_TURN_LEFT] 和 [CMD_TURN_RIGHT]键改变飞机的方向。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_FIGHTERS"
msgstr "（高爆）战斗机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_FIGHTERS_AP"
msgstr "(穿甲) 攻击机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_FIGHTERS_AP_DESCRIPTION"
msgstr "攻击机对付巡洋舰很有效。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_FIGHTERS_DESCRIPTION"
msgstr "攻击机对付高机动性目标很有效。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_JATO_DETACHABLE"
msgstr "油门助推器"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_JATO_DETACHABLE_DESCRIPTION"
msgstr ""
"在起飞期间极大提高中队的速度。\n"
" \n"
" 若要禁用，请按 [CMD_THROTTLE_DOWN]。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_LEAD"
msgstr "前置量"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_LEAD_DESCRIPTION"
msgstr "如果目标在运动中，请预判提前量并向其前方射击。船速越快，所需的提前量越大！"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_SKIP_BOMBERS_BOUNCE"
msgstr "跳过炸弹反弹"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_SKIP_BOMBERS_BOUNCE_DESCRIPTION"
msgstr "如果飞行高度过高，飞机投下的炸弹将不会反弹。等待中队飞到所需高度。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_SKIP_BOMBERS_HE"
msgstr "（高爆）弹跳轰炸机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_SKIP_BOMBERS_HE_DESCRIPTION"
msgstr "这种飞机搭载的高爆炸弹可在水面弹跳并使目标战舰起火。从侧面接近目标可以发挥最大效率。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_TORPERS"
msgstr "鱼雷轰炸机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_TORPERS_DESCRIPTION"
msgstr "这种类型的飞机装备有鱼雷，能有效对抗低机动性的目标。请从侧面攻击敌方战舰。"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_TORPERS_DW"
msgstr "（深水）鱼雷轰炸机"

msgid "IDS_TIPS_AIRCRAFT_SQUADRON_TORPERS_DW_DESCRIPTION"
msgstr ""
"这种类型的飞机装备有深水鱼雷，能有效对抗低机动性的目标。\n"
"只能击中吃水深的战舰。"

msgid "IDS_TIPS_AIRSUPPORT_BOMB_HE"
msgstr "高爆炸弹空袭"

msgid "IDS_TIPS_AIRSUPPORT_BOMB_HE_DESCRIPTION"
msgstr "按[CMD_AMMO_SLOT_4]键启用此武器。使用高爆弹对标记部位进行空袭。对大型装甲敌船最为有效。"

msgid "IDS_TIPS_AIR_DEFENSE"
msgstr "防空防御/副炮"

msgid "IDS_TIPS_AIR_DEFENSE_DESCRIPTION"
msgstr ""
"对空防御和副炮组会自动开火。\n"
"\n"
"为防止曳光弹在烟幕中暴露您的位置，您可以使用[CMD_SWITCH_ATBA_AIRDEFENSE]键禁用对空防御和副炮。"

msgid "IDS_TIPS_AIR_DEFENSE_SECTOR_GAIN"
msgstr "防空分区强化"

msgid "IDS_TIPS_AIR_DEFENSE_SECTOR_GAIN_DESCRIPTION"
msgstr ""
"按下[CMD_SET_PRIORITY_SECTOR]并选择优先防空区域，具体区域取决于敌方飞机的进攻方位\n"
"\n"
"这样做会降低其他区域的防空效率。\n"
"\n"
"加强将自动暂停。"

msgid "IDS_TIPS_ANTI_SUB_AIRCRAFT"
msgstr "反潜机"

msgid "IDS_TIPS_ANTI_SUB_AIRCRAFT_AUTO_DESCRIPTION"
msgstr "如果潜艇暴露自身位置，则自动使用深水炸弹轰炸潜艇的可能位置。"

msgid "IDS_TIPS_ANTI_SUB_AIRCRAFT_DESCRIPTION"
msgstr "按下[CMD_AMMO_SLOT_4]启用此武器。使用深水炸弹对标记部位进行空袭。只能对敌方潜艇造成伤害。"

msgid "IDS_TIPS_ARMAMENT_AP"
msgstr "穿甲弹(AP)"

msgid "IDS_TIPS_ARMAMENT_AP_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_2]选择穿甲弹。\n"
"\n"
"穿甲弹能有效对抗重甲目标。\n"
"\n"
"如果敌方战舰的装甲厚度不够，炮弹可能会过穿，并仅仅造成少量伤害。\n"
"\n"
"如果入射角太小，炮弹可能会被弹开。"

msgid "IDS_TIPS_ARMAMENT_CS"
msgstr "半穿甲弹(SAP)"

msgid "IDS_TIPS_ARMAMENT_CS_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_1]选择半穿甲弹。\n"
"\n"
"半穿甲弹能有效对抗轻甲目标。\n"
"\n"
"如果未击穿或发生跳弹，则不造成伤害。"

msgid "IDS_TIPS_ARMAMENT_HE"
msgstr "高爆弹(HE)"

msgid "IDS_TIPS_ARMAMENT_HE_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_1]选择高爆弹。\n"
"\n"
"高爆弹能有效对抗轻甲目标。\n"
"\n"
"这种炮弹有很高的机率造成火灾或者使配件瘫痪。"

msgid "IDS_TIPS_ARMSRACE"
msgstr "增益效果"

msgid "IDS_TIPS_ARMSRACE_DESCRIPTION"
msgstr ""
"增益在地图上随机出现，并显示为关键地区。\n"
"\n"
"取得增益能强化整队战舰和航母中队的属性。"

msgid "IDS_TIPS_ARM_TORPEDO_ALTERNATIVE"
msgstr "备用鱼雷"

msgid "IDS_TIPS_ARM_TORPEDO_ALTERNATIVE_DESCRIPTION"
msgstr ""
"您可在战斗中切换不同的鱼雷。\n"
"要切换不同的鱼雷，按下  [CMD_AMMO_SLOT_4]。\n"
"切换不同的鱼雷类型需要额外的装填时间。"

msgid "IDS_TIPS_ARTILLERY_BURST_FIRE"
msgstr "连发射击"

msgid "IDS_TIPS_ARTILLERY_BURST_FIRE_DESCRIPTION"
msgstr ""
"连发射击模式增加主炮组射速，让您可以在短时间内射击多次。\n"
"\n"
"每次连续齐射后需要长时间冷却。\n"
"\n"
"要切换不同的射击模式，按下[CMD_TOGGLE_FIRE_MODE]。"

msgid "IDS_TIPS_ASW_DEPTH_CHARGES"
msgstr "反潜作战：释放深水炸弹"

msgid "IDS_TIPS_ASW_DEPTH_CHARGES_DESCRIPTION"
msgstr "一旦获得敌方潜艇方位，立即接近并发动攻击。"

msgid "IDS_TIPS_BARRAGE_FIRE"
msgstr "防御型对空火力"

msgid "IDS_TIPS_BARRAGE_FIRE_DESCRIPTION"
msgstr ""
"可按下 [CMD_CONSUMABLE_1] 来启用消耗品。\n"
"\n"
"会提高防空火力的强度，以及减少敌方俯冲轰炸机和鱼雷轰炸机的攻击准度。"

msgid "IDS_TIPS_BATTLESHIP"
msgstr "战列舰"

msgid "IDS_TIPS_BATTLESHIP_DESCRIPTION"
msgstr ""
"战列舰搭载着最强大的舰炮。它们缓慢且不易移动，但其厚实的装甲则充分弥补了这一点。\n"
"\n"
"它们的主要目的，就是用主炮组火力来击毁敌方战舰。"

msgid "IDS_TIPS_BINOCULARS"
msgstr "双筒望远镜"

msgid "IDS_TIPS_BINOCULARS_DESCRIPTION"
msgstr ""
"为了更好瞄准目标，可按下 [CMD_ART_CAMERA] 来切换到望远镜视角。\n"
"\n"
"可使用鼠标滚轮 [KEY_MIDDLEMOUSE] 来放大和缩小。"

msgid "IDS_TIPS_CALL_FIGHTERS"
msgstr "巡逻战斗机"

msgid "IDS_TIPS_CALL_FIGHTERS_DESCRIPTION"
msgstr "巡逻区域并自动攻击敌方飞机。在返回基地前，可多次攻击空袭中队。不受敌方战斗机伤害。不会攻击敌方战斗机。不会发现敌方战舰。"

msgid "IDS_TIPS_CAPACITY"
msgstr "被侦测距离"

msgid "IDS_TIPS_CAPACITY_DESCRIPTION"
msgstr "用来确定敌人能发现该战舰的范围。您的战舰被发现时会显示一个指示器。"

msgid "IDS_TIPS_CATAPULT_FIGHTER"
msgstr "战斗机"

msgid "IDS_TIPS_CATAPULT_FIGHTER_DESCRIPTION"
msgstr "跟随战舰并自动攻击敌方飞机。在返回战舰前，可多次攻击空袭中队。不会发现敌方战舰。"

msgid "IDS_TIPS_CRUISERS"
msgstr "巡洋舰"

msgid "IDS_TIPS_CRUISERS_DESCRIPTION"
msgstr ""
"良好的装甲防护和强大的舰炮。充足的机动力使这些战舰能够闪躲驱逐舰的鱼雷，以及躲开战列舰的炮弹。\n"
"\n"
"巡洋舰的职责包含跟敌方驱逐舰和巡洋舰对战，同时提供火炮支援以及用防空火力来保护队友。"

msgid "IDS_TIPS_DEEP_TORPEDES"
msgstr "深水（DT）鱼雷"

msgid "IDS_TIPS_DEEP_TORPEDES_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_3]选择深水鱼雷。\n"
"\n"
"只能击中吃水较深的战舰。对驱逐舰无效。拥有较低的被侦测性。"

msgid "IDS_TIPS_DEFENSE"
msgstr "前置量"

msgid "IDS_TIPS_DEFENSE_DESCRIPTION"
msgstr "如果目标正在移动，就要朝其移动方向的前方处射击。您与目标的距离越远，前置量就会越大！"

msgid "IDS_TIPS_DEPTH_CHARGES"
msgstr "深水炸弹"

msgid "IDS_TIPS_DEPTH_CHARGES_DESCRIPTION"
msgstr ""
"按下[CMD_AMMO_SLOT_G]键释放深水炸弹。\n"
"\n"
"可有效对抗潜艇。\n"
"这些炸弹有几率造成起火和进水。\n"
"以组为单位释放。"

msgid "IDS_TIPS_DESTROYERS"
msgstr "驱逐舰"

msgid "IDS_TIPS_DESTROYERS_DESCRIPTION"
msgstr ""
"驱逐舰擅长以航速、机动力、隐匿性和鱼雷伤害的致命组合来进行突袭。\n"
"\n"
"对敌方重型战舰实施鱼雷攻击，并通过施放烟幕来为我方部队提供掩护。"

msgid "IDS_TIPS_FIRE_AND_FLOODING"
msgstr "起火与进水"

msgid "IDS_TIPS_FIRE_AND_FLOODING_DESCRIPTION"
msgstr ""
"起火与进水在解决之前都会对您的战舰造成伤害。\n"
"\n"
"可使用伤害控制小组消耗品 [CMD_CONSUMABLE_0] 来加快火灾与进水的恢复。"

msgid "IDS_TIPS_FIRE_CORRECTIONER"
msgstr "侦察机"

msgid "IDS_TIPS_FIRE_CORRECTIONER_DESCRIPTION"
msgstr "增加主炮组射程。提供额外的空中侦察能力。"

msgid "IDS_TIPS_FORCING"
msgstr "引擎增压"

msgid "IDS_TIPS_FORCING_DESCRIPTION"
msgstr ""
"可按下 [CMD_CONSUMABLE_2] 来启用消耗品。\n"
"\n"
"用来暂时提高战舰的最大航速。"

msgid "IDS_TIPS_HEAL_FORSAGE"
msgstr "引擎冷却"

msgid "IDS_TIPS_HEAL_FORSAGE_DESCRIPTION"
msgstr "允许您在有限的一段时间内，使用引擎增压并避免引擎过热。"

msgid "IDS_TIPS_HYBRID_TACTICS_AA_DANGER"
msgstr "敌方防空火力"

msgid "IDS_TIPS_HYBRID_TACTICS_AA_DANGER_DESCRIPTION"
msgstr "如果您的中队同时遭受多艘战舰的防空火力，您可能会迅速损失您的中队。"

msgid "IDS_TIPS_HYBRID_TACTICS_AIMING"
msgstr "瞄准"

msgid "IDS_TIPS_HYBRID_TACTICS_AIMING_DESCRIPTION"
msgstr "当您操控一个中队时，其主要武器将瞄准您起飞前指定的位置。"

msgid "IDS_TIPS_HYBRID_TACTICS_DAMAGE_DEALING"
msgstr "额外伤害"

msgid "IDS_TIPS_HYBRID_TACTICS_DAMAGE_DEALING_DESCRIPTION"
msgstr "当您的主武器在重新装填时，您可以使用攻击机对敌人造成伤害。"

msgid "IDS_TIPS_HYBRID_TACTICS_ISLAND"
msgstr "掩体后的敌人"

msgid "IDS_TIPS_HYBRID_TACTICS_ISLAND_DESCRIPTION"
msgstr "如果您的对手在掩体后躲避您主要武器的攻击，您依然可以使用攻击机对其造成伤害。"

msgid "IDS_TIPS_HYBRID_TACTICS_RETURN_TO_SHIP"
msgstr "应对危险"

msgid "IDS_TIPS_HYBRID_TACTICS_RETURN_TO_SHIP_DESCRIPTION"
msgstr ""
"您的舰船标记将会向您报告各种危险。那时候您可能需要快速采取行动。\n"
"\n"
"按[CMD_LAND]键从中队操控切回战舰操控。"

msgid "IDS_TIPS_HYBRID_TACTICS_SCOUTING"
msgstr "空中侦查"

msgid "IDS_TIPS_HYBRID_TACTICS_SCOUTING_DESCRIPTION"
msgstr "攻击机可以用来侦查敌方战舰。"

msgid "IDS_TIPS_HYDROACUSTIC_SEARCH"
msgstr "对海搜索"

msgid "IDS_TIPS_HYDROACUSTIC_SEARCH_DESCRIPTION"
msgstr "提高对敌方舰艇与鱼雷的绝对捕获范围，包括身处于烟幕区域之内的对象。"

msgid "IDS_TIPS_MAIN_CALIBER_RELOAD_BOOST"
msgstr "主炮装填推助器"

msgid "IDS_TIPS_MAIN_CALIBER_RELOAD_BOOST_DESCRIPTION"
msgstr "暂时加快主炮的装填速度"

msgid "IDS_TIPS_MAIN_CALIBER_SHOOTING"
msgstr "用主炮开火"

msgid "IDS_TIPS_MAIN_CALIBER_SHOOTING_DESCRIPTION"
msgstr ""
"将准星瞄准敌方战舰并等候指示器转变成绿色，那代表着舰炮何时准备好开火。\n"
"\n"
"按住 [KEY_LEFTMOUSE] 来依序射击。\n"
"双击[KEY_LEFTMOUSE_DOUBLE]来让所有炮塔进行齐射。"

msgid "IDS_TIPS_MINES"
msgstr "雷区"

msgid "IDS_TIPS_MINES_DEMINING"
msgstr "对抗水雷"

msgid "IDS_TIPS_MINES_DEMINING_DESCRIPTION"
msgstr "使用战舰或空袭深水炸弹摧毁水雷。"

msgid "IDS_TIPS_MINES_DESCRIPTION"
msgstr ""
"M系航空母舰埃塞克斯的轰炸机中队可以部署雷区。\n"
"\n"
"当敌舰接触到水雷时，它们可以造成巨大伤害并导致进水。\n"
"\n"
"在与友方战舰接触时，水雷会失效，但不会造成伤害。"

msgid "IDS_TIPS_MINES_DETECTION"
msgstr "探测水雷"

msgid "IDS_TIPS_MINES_DETECTION_DESCRIPTION"
msgstr ""
"水雷只有在距离战舰较近时才能探测到。\n"
"\n"
"对海搜索、反潜探测、水听器和监视雷达无法增加水雷探测范围。"

msgid "IDS_TIPS_MINIMAP"
msgstr "小地图"

msgid "IDS_TIPS_MINIMAP_DESCRIPTION"
msgstr ""
"小地图上，会以白色来显示您的战舰。队友及敌方战舰分别为绿色和红色。同样的色彩组合也会套用到基地及占领点上。\n"
"\n"
"使用 [MAP_SCALE_MINUS] 和 [MAP_SCALE_PLUS] 键来让小地图放大及缩小。"

msgid "IDS_TIPS_MOVEMENT_UNDER_FIRE"
msgstr "被攻击时的移动"

msgid "IDS_TIPS_MOVEMENT_UNDER_FIRE_DESCRIPTION"
msgstr "通过改变航速的移动来摆脱掉敌人的瞄准。"

msgid "IDS_TIPS_PINGED_SECTOR_ON_SHIP"
msgstr "被高亮部位"

msgid "IDS_TIPS_PINGED_SECTOR_ON_SHIP_DESCRIPTION"
msgstr "潜艇使用声呐来高亮舰船部位，以便鱼雷定位。使用伤害控制小组避免被定位。"

msgid "IDS_TIPS_PLANE_SMOKES"
msgstr "烟幕发生器"

msgid "IDS_TIPS_PLANE_SMOKES_DESCRIPTION"
msgstr ""
"R系航空母舰鹩的飞机中队机可以设置烟幕。\n"
"\n"
"您可以使用烟幕发生器为队友提供掩护或阻挡敌舰视线。"

msgid "IDS_TIPS_POINTING_GUNS"
msgstr "舰炮瞄准"

msgid "IDS_TIPS_POINTING_GUNS_DESCRIPTION"
msgstr "需要花时间来回转舰炮。炮塔将会跟随视角镜头。"

msgid "IDS_TIPS_RAGE_MODE_ADJUSTMENT_FIRE"
msgstr "战斗指令"

msgid "IDS_TIPS_RAGE_MODE_ADJUSTMENT_FIRE_DESCRIPTION"
msgstr ""
"战斗指令使战舰武器特性获得临时增益。\n"
"\n"
"完成激活条件后，您可按下 [CMD_ACTIVATE_RAGE_MODE] 来激活战斗指令。\n"
"\n"
"间隔过长会减少激活条件的完成进度。"

msgid "IDS_TIPS_REGENCREW"
msgstr "生命值"

msgid "IDS_TIPS_REGENCREW_DESCRIPTION"
msgstr "当战舰的生命值用完时，它就会被摧毁。"

msgid "IDS_TIPS_REGENERATE_PLANE_HEALTH"
msgstr "维修"

msgid "IDS_TIPS_REGENERATE_PLANE_HEALTH_DESCRIPTION"
msgstr ""
"恢复飞机中队部分生命值。\n"
"在敌方战斗机攻击时使用能免于被击毁。"

msgid "IDS_TIPS_REPAIR_CONSUMABLE_01"
msgstr "伤害控制小组"

msgid "IDS_TIPS_REPAIR_CONSUMABLE_01_DESCRIPTION"
msgstr ""
"可按下 [CMD_CONSUMABLE_0] 来启用消耗品。\n"
"\n"
"它可以修理受损配件、扑灭火灾以及阻止进水。\n"
"\n"
"如果您遭受到严重的攻击，不要急着使用您的伤害控制小组。"

msgid "IDS_TIPS_REPAIR_CONSUMABLE_02"
msgstr "维修小组"

msgid "IDS_TIPS_REPAIR_CONSUMABLE_02_DESCRIPTION"
msgstr ""
"可按下 [CMD_CONSUMABLE_0] 来启用消耗品。\n"
"\n"
"可通过除去轻微的损伤来部分恢复战舰的生命值。\n"
"\n"
"生命值指示器上的灰色部分会显示出可恢复的战舰生命值。"

msgid "IDS_TIPS_SEARCHING_RLS"
msgstr "监视雷达"

msgid "IDS_TIPS_SEARCHING_RLS_DESCRIPTION"
msgstr "大幅提高对敌方战舰的绝对捕获范围，包括处于烟幕区域之内的目标。"

msgid "IDS_TIPS_SHIP_MANAGEMENT"
msgstr "战舰控制"

msgid "IDS_TIPS_SHIP_MANAGEMENT_DESCRIPTION"
msgstr ""
"使用[CRUISE_SPEED_UP]和[CRUISE_SPEED_DOWN]键来控制战舰的航速。\n"
"\n"
"想要转向，请按下 [CMD_MOVE_LEFT] 及 [CMD_MOVE_RIGHT]。"

msgid "IDS_TIPS_SHIP_MOVEMENT"
msgstr "战舰移动"

msgid "IDS_TIPS_SHIP_MOVEMENT_DESCRIPTION"
msgstr ""
"战舰会缓慢地响应加速或停伡的指令。\n"
"\n"
"请计划好您的行动和移动，并提早准备转向。"

msgid "IDS_TIPS_SHOOTING_AP"
msgstr "发射 AP 弹"

msgid "IDS_TIPS_SHOOTING_AP_DESCRIPTION"
msgstr "使用穿甲弹[CMD_AMMO_SLOT_2]时，尽量瞄准敌舰主炮塔下方和推进系统。弹道与敌舰装甲的夹角越小，发生未击穿和跳弹的几率越高。"

msgid "IDS_TIPS_SHOOTING_HE"
msgstr "发射 HE 弹"

msgid "IDS_TIPS_SHOOTING_HE_DESCRIPTION"
msgstr "使用高爆弹[CMD_AMMO_SLOT_1]时，瞄准敌舰的上层建筑。"

msgid "IDS_TIPS_SMOKE"
msgstr "烟幕"

msgid "IDS_TIPS_SMOKE_DESCRIPTION"
msgstr "烟幕可把自己与我方战舰的确切位置给隐藏起来。"

msgid "IDS_TIPS_SMOKE_GENERATOR"
msgstr "发烟器"

msgid "IDS_TIPS_SMOKE_GENERATOR_DESCRIPTION"
msgstr ""
"可使用 [CMD_CONSUMABLE_1] 来启用消耗品。\n"
"\n"
"它是用来在您的战舰后方施放烟幕，降低被敌人发现的风险。"

msgid "IDS_TIPS_START_TORPEDOES"
msgstr "鱼雷发射"

msgid "IDS_TIPS_START_TORPEDOES_DESCRIPTION"
msgstr ""
"发射鱼雷前要先计算好提前量。锁定目标后，您会看见一个白色的提前量楔形。\n"
"\n"
"想要改变扩散的宽度，请再次按下 [CMD_AMMO_SLOT_3]。\n"
"\n"
"释放鱼雷前，请先确认路径上没有队友。"

msgid "IDS_TIPS_SUBMARINES"
msgstr "潜艇"

msgid "IDS_TIPS_SUBMARINES_DESCRIPTION"
msgstr "潜艇可有效对抗巡洋舰和驱逐舰。潜艇的下潜深度会影响被发现的可能性、视野范围，以及与其他潜艇和舰船互动的概率。"

msgid "IDS_TIPS_SUBMARINE_ACOUSTIC_TORPEDO"
msgstr "声呐制导鱼雷"

msgid "IDS_TIPS_SUBMARINE_ACOUSTIC_TORPEDO_DESCRIPTION"
msgstr ""
"按 [CMD_AMMO_SLOT_2] 键选择鱼雷武器。\n"
"当声呐探测命中目标舰体的特殊位置后，鱼雷齐射将变得更有效。"

msgid "IDS_TIPS_SUBMARINE_ALTERNATIVE_TORPEDO"
msgstr "声导鱼雷"

msgid "IDS_TIPS_SUBMARINE_ALTERNATIVE_TORPEDO_DESCRIPTION"
msgstr "按下 [CMD_AMMO_SLOT_2] 或 [CMD_AMMO_SLOT_3] 按键即可选择鱼雷武器。"

msgid "IDS_TIPS_SUBMARINE_ANTI_SUBMARINE_WARFARE"
msgstr "反潜战"

msgid "IDS_TIPS_SUBMARINE_ANTI_SUBMARINE_WARFARE_DESCRIPTION"
msgstr ""
"敌方驱逐舰和轻型巡洋舰搭载了潜艇侦察设备和深水炸弹。\n"
"\n"
"您最好远离它们。"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_ENERGY_FREEZE"
msgstr "储备蓄电池组"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_ENERGY_FREEZE_DESCRIPTION"
msgstr "生效后，下潜能力不会消耗"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_FAST_DEPTH_RUDDERS"
msgstr "强化型方向舵装置"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_FAST_DEPTH_RUDDERS_DESCRIPTION"
msgstr "使用此消耗品在遇到危险时快速下潜或上浮。"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_HYDROPHONE"
msgstr "水听器"

msgid "IDS_TIPS_SUBMARINE_CONSUMABLE_HYDROPHONE_DESCRIPTION"
msgstr "高亮显示位于定位距离内的水面或潜望镜深度的战舰和潜艇位置。只显示消耗品激活时的舰艇位置。"

msgid "IDS_TIPS_SUBMARINE_DEPTH_CONTROL"
msgstr "下潜和上浮"

msgid "IDS_TIPS_SUBMARINE_DEPTH_CONTROL_DESCRIPTION"
msgstr "按下[CMD_MOVE_DOWN]键让潜艇下潜，[CMD_MOVE_UP]键上浮。"

msgid "IDS_TIPS_SUBMARINE_DEPTH_INVULNERABLE"
msgstr "潜艇被侦查范围"

msgid "IDS_TIPS_SUBMARINE_DEPTH_INVULNERABLE_DESCRIPTION"
msgstr "处于最大深度时，潜艇只能使用特殊装备才能被探测到。"

msgid "IDS_TIPS_SUBMARINE_ENERGY_BURNING"
msgstr "潜艇下潜能力"

msgid "IDS_TIPS_SUBMARINE_ENERGY_BURNING_DESCRIPTION"
msgstr "被侦察到后，潜艇下潜能力消耗速度会加快。如果完全消耗，潜艇将自动上浮。"

msgid "IDS_TIPS_SUBMARINE_ENERGY_IF_SPOTTED"
msgstr "下潜能力耗尽"

msgid "IDS_TIPS_SUBMARINE_ENERGY_IF_SPOTTED_DESCRIPTION"
msgstr "潜艇被敌方侦察到后，下潜能力消耗速度会加快。尽量避免被侦察到，保持下潜能力，直至战斗的结束。"

msgid "IDS_TIPS_SUBMARINE_ENERGY_MANAGEMENT"
msgstr "下潜能力"

msgid "IDS_TIPS_SUBMARINE_ENERGY_MANAGEMENT_DESCRIPTION"
msgstr ""
"需要它才能在水下和在深处进行机动。\n"
"\n"
"如果下潜能力耗尽，潜艇将会上浮。\n"
"\n"
"在水面上时，下潜能力将会恢复。"

msgid "IDS_TIPS_SUBMARINE_IMPULSE"
msgstr "声呐"

msgid "IDS_TIPS_SUBMARINE_IMPULSE_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_1]键选择声呐。\n"
"\n"
"声呐探测将会高亮敌方战舰上的部位，鱼雷将被导向此处。\n"
"\n"
"高亮部位有限制时间。"

msgid "IDS_TIPS_SUBMARINE_PINGED_SECTOR"
msgstr "第二次被高亮部位"

msgid "IDS_TIPS_SUBMARINE_PINGED_SECTOR_DESCRIPTION"
msgstr "第二次命中一个高亮部位时可以提高声学制导鱼雷的机动性。"

msgid "IDS_TIPS_SUBMARINE_TORPEDOES_MANEUVERABILITY"
msgstr "发射深水鱼雷"

msgid "IDS_TIPS_SUBMARINE_TORPEDOES_MANEUVERABILITY_DESCRIPTION"
msgstr ""
"被高亮为黑色的敌军舰船无法被鱼雷击中。\n"
"\n"
"鱼雷需要一定时间上浮。"

msgid "IDS_TIPS_TACTICAL_AVIATION"
msgstr "战术中队"

msgid "IDS_TIPS_TACTICAL_AVIATION_DESCRIPTION"
msgstr ""
"可以利用速度对敌方战舰进行快速打击。\n"
"\n"
"一支中队只会进行一次飞行，而且有相当长的准备时间。\n"
"\n"
"飞机上安装的引擎增压在飞机升空后不会恢复。"

msgid "IDS_TIPS_TARGET_CAPTURING"
msgstr "目标锁定"

msgid "IDS_TIPS_TARGET_CAPTURING_DESCRIPTION"
msgstr "用准星锁定敌舰进行精确射击。按[CMD_FIXING_TARGET_POSITION]键来切换至另一个目标。"

msgid "IDS_TIPS_TORPEDOES"
msgstr "鱼雷"

msgid "IDS_TIPS_TORPEDOES_DESCRIPTION"
msgstr ""
"按[CMD_AMMO_SLOT_3]选择鱼雷武器。\n"
"\n"
"对敌方大型的装甲舰最有效。机动性好的战舰有很高的机率能躲开鱼雷攻击。"

msgid "IDS_TIPS_TORPEDOES_MOVEMENT_DISTANCE"
msgstr "鱼雷射程"

msgid "IDS_TIPS_TORPEDOES_MOVEMENT_DISTANCE_DESCRIPTION"
msgstr "记住，鱼雷[CMD_AMMO_SLOT_3]的射程是有限的。当您的战舰离敌人足够近时再发射鱼雷。"

msgid "IDS_TIPS_TORPEDOES_RELOAD_SYSTEM"
msgstr "鱼雷装填助推器"

msgid "IDS_TIPS_TORPEDOES_RELOAD_SYSTEM_DESCRIPTION"
msgstr "启用后，此消耗品会显著减少鱼雷发射管的装填时间。"

