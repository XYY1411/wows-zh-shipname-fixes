msgid "IDS_NAVAL_BASE_RULES_MODAL_BASICS_TITLE"
msgstr "M系海港海军基地有五个区域，分别包含不同类型的活动：军港、海军指挥部、行动指挥部、燃油站和记忆盒子。除记忆盒子外的所有区域都可以升级。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_1_TEXT_1"
msgstr "每个远征都有特定要求，包括舰队战力——也就是您为此远征指派的全部战舰的总计战力。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_1_TEXT_2"
msgstr "选择合适的战舰，舰队组建完毕后即可开始远征。远征中的战舰暂时无法参与其他远征。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_1_TEXT_3"
msgstr "开放的远征数量取决于军港等级。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_1_TITLE"
msgstr "远征"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_2_TEXT_1"
msgstr "您可以进行持续一天或三天的远征。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_2_TEXT_2"
msgstr "三日远征需要的舰队战力较低，而且可以带来更多奖励，但是战舰会在较长一段时间内无法参与其他远征。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_2_TEXT_3"
msgstr "一日远征需要更高的舰队战力，但是如果每天都派出一日远征，三天时间中获得的总计资源比单次三日远征要多。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_RULE_2_TITLE"
msgstr "远征持续时间"

msgid "IDS_NAVAL_BASE_RULES_MODAL_EXPEDITIONS_TITLE"
msgstr "您可以在军港区域中指派战舰进行远征，获取用于建造和升级的海军基地补给。参与远征的战舰依然可以加入战斗。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_HEADER"
msgstr "规则"

msgid "IDS_NAVAL_BASE_RULES_MODAL_HEADER_GO_BACK"
msgstr "返回M系海港"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_RULE_1_TEXT_1"
msgstr "强化区域后可以解锁额外任务或远征。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_RULE_1_TEXT_2"
msgstr "强化有时间限制。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_RULE_1_TITLE"
msgstr "使用强化"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_RULE_2_TEXT_1"
msgstr "升级燃油站后，您可以为其他区域指派更多额外任务或远征。三级燃油站可以同时强化两个区域。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_RULE_2_TITLE"
msgstr "燃油站等级"

msgid "IDS_NAVAL_BASE_RULES_MODAL_OVERCHARGE_TITLE"
msgstr "燃油站是一个辅助区域，可以强化海军指挥部和行动指挥部，解锁更多作战任务，或强化军港，解锁更多远征。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_1_TEXT_1"
msgstr "升级M系海港区域的同时，您将获得记忆片段。解锁记忆片段即可获得记忆盒子中的奖励。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_1_TEXT_2"
msgstr "每个记忆片段都包含M系海军历史上的一个重要时刻。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_1_TITLE"
msgstr "记忆片段"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_2_TEXT_1"
msgstr "取得最终奖励后，您将解锁额外奖励。之后获得的所有海军基地补给都会累积在记忆盒子区域的进度条中。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_2_TEXT_2"
msgstr "每次填满进度条都能获得一个M系海港收藏代币。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_RULE_2_TITLE"
msgstr "额外奖励"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PHOTO_ALBUM_TITLE"
msgstr "您可以在记忆盒子中查看您收集的记忆片段。记忆盒子还会显示您在活动中的进度。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_1_TEXT_1"
msgstr "区域等级越高，作战任务列表中可选择的任务数量越多。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_1_TEXT_2"
msgstr "升至3级后，您每天最多可完成七个作战任务。您同时只能接受当前区域等级允许的任务数量（最多%(maxAmount)s个）。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_1_TEXT_3"
msgstr "作战任务每天刷新。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_1_TITLE"
msgstr "作战任务"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_2_TEXT_1"
msgstr "每天，您都有几率收到一个双倍奖励任务。基础几率为10%，但是可以通过升级区域，推进中间阶段，提升此几率。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_RULE_2_TITLE"
msgstr "双倍奖励任务"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVE_MISSIONS_TITLE"
msgstr "在行动指挥部区域中，您可以接受能在联合作战、行动和限时战斗类型中完成的任务。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_1_TEXT_1"
msgstr "区域等级越高，可选作战任务列表就越长。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_1_TEXT_2"
msgstr "升至3级后，您每天最多可完成7个作战任务。您同时只能接受当前区域等级允许的任务数量（最多%(maxAmount)s个）。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_1_TEXT_3"
msgstr "作战任务列表每天刷新"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_1_TITLE"
msgstr "作战任务"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_2_TEXT_1"
msgstr "每天，您都有几率收到一个双倍奖励任务。基础几率为10%，但是可以通过升级区域，推进中间阶段，提升此几率。"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_RULE_2_TITLE"
msgstr "双倍奖励任务"

msgid "IDS_NAVAL_BASE_RULES_MODAL_PVP_MISSIONS_TITLE"
msgstr "在海军指挥部区域中，您可以接受能在标准战斗、排位战和对决中完成的作战任务。"

