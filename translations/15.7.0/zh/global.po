msgid "IDS_DOGTAG_PCNA040_NAME"
msgstr "五边形"

msgid "IDS_DOGTAG_PCNA041_NAME"
msgstr "收藏家的盾"

msgid "IDS_DOGTAG_PCNA042_NAME"
msgstr "能量盾"

msgid "IDS_DOGTAG_PCNA043_NAME"
msgstr "北极"

msgid "IDS_DOGTAG_PCNA044_NAME"
msgstr "黑色星期五：五角形"

msgid "IDS_DOGTAG_PCNA045_NAME"
msgstr "黑色星期五：七角形"

