msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_HEADER"
msgstr "战斗特点"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_TEXT_1"
msgstr "代号为“犹他”的海滩是盟军在诺曼底最西端的登陆区域。1944年6月6日黎明，为解放旧大陆铺平道路的大规模行动在诺曼底海岸拉开了序幕。"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_TEXT_2"
msgstr "您将沉浸在这场历史战役中，与盟军一起发起进攻。"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_TEXT_3"
msgstr "完成行动目标后，您将获得包括秘密文件在内的奖励。"

