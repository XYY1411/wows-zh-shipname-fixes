msgid "IDS_PCEE055_PERTH_FLAG_DESCRIPTION"
msgstr "1942年二月，珀斯在盟军战败的战役中存活了下来，但后来在海战中被R系海军的鱼雷击中沉没。"

msgid "IDS_PCEE056_PROJECT_OIL"
