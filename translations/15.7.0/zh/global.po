msgid "IDS_MODAL_WINDOW_GRAND_STRATEGY_PASS_RULES_PARAGRAPH_1_TEXT_1"
msgstr "花费战斗通行证点数即可占领区域并在地图上扩张。每占领一个区域即可获得一份奖励。您可通过作战任务获取战斗通行证点数。"

msgid "IDS_MODAL_WINDOW_GRAND_STRATEGY_PASS_RULES_PARAGRAPH_2_HEADER"
msgstr "地区和区域"

msgid "IDS_MODAL_WINDOW_GRAND_STRATEGY_PASS_RULES_PARAGRAPH_2_TEXT_1"
