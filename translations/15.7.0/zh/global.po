msgid "IDS_MODAL_WINDOW_GRAND_STRATEGY_PASS_RULES_PARAGRAPH_6_TEXT_1"
msgstr "优先占领带有航空母舰的区域，即可提升关联区域的奖励。"

msgid "IDS_MODAL_WINDOW_GRAND_STRATEGY_PASS_RULES_PARAGRAPH_7_HEADER"
