msgid "IDS_PCEE038_OLYMPICS_FLAG_DESCRIPTION"
msgstr "颁发给终极赢家。"

msgid "IDS_PCEE039_GAMESCOM_2016"
msgstr "gamescom 2016"

msgid "IDS_PCEE039_GAMESCOM_2016_DESCRIPTION"
msgstr "2016年的大型游戏活动 – 科隆游戏展。您当时也在那里，而我们希望能再次见到您！"

msgid "IDS_PCEE040_BURNING_MAN"
msgstr "黑岩"

msgid "IDS_PCEE040_BURNING_MAN_DESCRIPTION"
msgstr "给予那些参与美术及社群考察的人。"

msgid "IDS_PCEE041_PLAYER_GATHERING"
msgstr "开启战斗之旅旗帜"

msgid "IDS_PCEE041_PLAYER_GATHERING_DESCRIPTION"
msgstr "颁发给出席“开启战斗”活动的玩家！"

msgid "IDS_PCEE042_BIRTHDAY_FLAG"
msgstr "游戏已经一岁了"

msgid "IDS_PCEE042_BIRTHDAY_FLAG_DESCRIPTION"
msgstr "在一起也有一年了！"

msgid "IDS_PCEE043_RESTLESS_FIRE"
msgstr "重炮不断"

msgid "IDS_PCEE043_RESTLESS_FIRE_DESCRIPTION"
msgstr "您是游戏社区不可缺少的一份子。"

msgid "IDS_PCEE044_PRINZ_EUGEN"
msgstr "欧根亲王"

msgid "IDS_PCEE044_PRINZ_EUGEN_DESCRIPTION"
msgstr ""
"欧根亲王 是在莱茵河演习行动期间投入作战，于 1941 年五月与战列舰 俾斯麦 号一起试图突破阿特拉斯海防线。两艘舰艇在海峡海战中击毁了战列巡洋舰 胡德 号并且严重损伤战列舰 威尔士亲王 号。\n"
"1945 年五月E系战争结束后，它在被转交给M系海军作为战利品前是向Y系海军投降。在M系考察过舰艇之后，指派这艘巡洋舰前往比基尼环礁的十字路行动核试验。"

msgid "IDS_PCEE045_YOKOSUKA_MARINE_SCHOOL"
msgstr "横须贺海洋女子学校"

msgid "IDS_PCEE045_YOKOSUKA_MARINE_SCHOOL_DESCRIPTION"
msgstr ""
"“横须贺女子海军高校”的校徽。\n"
"这所学校是为了培养“蓝色人鱼”而成立。"

msgid "IDS_PCEE045_YOKOSUKA_MARINE_SCHOOL_EXTRA_DESCRIPTION"
msgstr "出自于系列动画“高校舰队”。"

msgid "IDS_PCEE046_PIRATE_DAY_FLAG"
msgstr "冒险家模仿日"

msgid "IDS_PCEE046_PIRATE_DAY_FLAG_DESCRIPTION"
msgstr "啊恶！！！"

msgid "IDS_PCEE047_WAITFORME"
msgstr "援助之手"

msgid "IDS_PCEE047_WAITFORME_DESCRIPTION"
msgstr "给予在战斗中无私奉献英勇作战的人。"

msgid "IDS_PCEE048_SEASONFLAG05"
msgstr "WL"

msgid "IDS_PCEE048_SEASONFLAG05_DESCRIPTION"
msgstr ""
"泥岛是D系在两次大战期间最大的海军基地。该城市是由国王威廉一世作为D系海军基地而于1869年开始进行建设，随后在1871年建立了造船厂。直到1918年为止，这个基地一直都是处于D系海军的管辖之下。"

msgid "IDS_PCEE048_SEASONFLAG05_EXTRA_DESCRIPTION"
msgstr "在排位战第五赛季达到第15名时授予。"

